---
import categorias from "../data/categorias.json";
import laboratorios from "../data/laboratorios.json";
import productos from "../data/productos.json";
import "../styles/global.css";

const siteUrl = "https://pocima.co/";
const title = "PÓCIMA | Bebidas, productos naturales y suplementos";
const description =
  "Descubre PÓCIMA, una marca comercial con bebidas, productos naturales y suplementos de diferentes fabricantes. Explora el catálogo y consulta las presentaciones disponibles.";

const ogImage = `${siteUrl}images/og-pocima.jpg`;
const instagram = "https://www.instagram.com/pocimaco/";

const productosVisibles = productos.filter(
  (producto) => producto.publicar !== false
);

const categoriasVisibles = categorias;

const laboratoriosVisibles = laboratorios;

const formatoPrecio = (precio) =>
  new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  }).format(precio ?? 0);

const nombreLaboratorio = (slug) =>
  laboratorios.find((laboratorio) => laboratorio.slug === slug)?.nombre ??
  "Fabricante por confirmar";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "PÓCIMA",
      url: siteUrl,
      logo: `${siteUrl}icons/pocima-192.png`,
      email: "hola@pocima.co",
      sameAs: [instagram],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "PÓCIMA",
      description,
      inLanguage: "es-CO",
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={siteUrl} />
    <link rel="alternate" hreflang="es-CO" href={siteUrl} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/pocima-192.png" />
    <link rel="apple-touch-icon" href="/icons/pocima-192.png" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="PÓCIMA" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
  property="og:image:alt"
  content="PÓCIMA, marca comercial de productos naturales, suplementos y bebidas"
/>

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pocimaco" />
    <meta name="twitter:creator" content="@pocimaco" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
  name="twitter:image:alt"
  content="PÓCIMA, marca comercial de productos naturales, suplementos y bebidas"
/>

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fuentes: preconnect + display=swap (evita bloquear el render con @import) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="image"
      href="/images/envase-pocima-25ml.webp"
      type="image/webp"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap"
    />
  </head>

<body>
  <a href="#contenido" class="skip-link">Saltar al contenido</a>

  <header class="navbar">
    <button id="install-pwa" class="install-button" hidden>
      Instalar PÓCIMA
    </button>

    <a href="/" class="logo" aria-label="PÓCIMA, inicio">PÓCIMA</a>

    <nav aria-label="Principal">
      <a href="#categorias">Categorías</a>
      <a href="#catalogo">Catálogo</a>
      <a href="#laboratorios">Laboratorios</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </header>

  <main id="contenido">
    <!-- HERO DE MARCA -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <p class="eyebrow">PÓCIMA · pocima.co</p>

        <h1 id="hero-title">
          PÓCIMA
          <span>Un catálogo para descubrir.</span>
        </h1>

        <p class="hero-text">
          Productos naturales, suplementos y bebidas de diferentes
          fabricantes, reunidos en un solo lugar. Explora nuestras
          categorías y encuentra la presentación que buscas.
        </p>

        <a href="#catalogo" class="button">Explorar catálogo</a>
      </div>

      <div class="hero-product brand-visual" aria-label="Marca PÓCIMA">
        <div class="glow" aria-hidden="true"></div>
        <div class="brand-mark">
          PÓCIMA
          <span>Descubre el catálogo</span>
        </div>
      </div>
    </section>

    <!-- CATEGORÍAS -->
    <section
      id="categorias"
      class="catalogo-section"
      aria-labelledby="categorias-title"
    >
      <div class="section-heading">
        <p class="eyebrow">EXPLORA</p>
        <h2 id="categorias-title">Nuestras <span>categorías.</span></h2>
        <p>
          Encuentra productos por tipo, presentación o línea.
          Selecciona una categoría para ver sus productos.
        </p>
      </div>

      <div class="category-grid">
        {categorias.map((categoria) => (
          <a
            class="category-card"
            href={`#categoria-${categoria.slug}`}
          >
            <span class="category-name">{categoria.nombre}</span>
            <span class="category-description">
              {categoria.descripcion}
            </span>
            <span class="category-link">Explorar categoría ↗</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CATÁLOGO -->
    <section
      id="catalogo"
      class="catalogo-section"
      aria-labelledby="catalogo-title"
    >
      <div class="section-heading">
        <p class="eyebrow">PRODUCTOS</p>
        <h2 id="catalogo-title">El catálogo <span>PÓCIMA.</span></h2>
        <p>
          Consulta las presentaciones y los precios disponibles.
          Cada producto conserva su propia página.
        </p>
      </div>

      {categorias.map((categoria) => {
        const productosCategoria = productosVisibles.filter(
          (producto) => producto.categorias?.includes(categoria.slug)
        );

        return (
          <section
            id={`categoria-${categoria.slug}`}
            class="catalog-category"
            aria-labelledby={`titulo-${categoria.slug}`}
          >
            <div class="group-heading">
              <h3 id={`titulo-${categoria.slug}`}>
                {categoria.nombre}
              </h3>
              <p>{categoria.descripcion}</p>
            </div>

            {productosCategoria.length > 0 ? (
              <div class="product-grid">
                {productosCategoria.map((producto) => {
                  const foto =
                    producto.imagenes?.[0] ||
                    producto.imagenesOriginales?.[0];

                  return (
                    <a
                      class="tarjeta-catalogo"
                      href={`/${producto.slug}`}
                    >
                      <div class="foto-catalogo">
                        {foto ? (
                          <img
                            src={foto}
                            alt={producto.nombre}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span>Fotografía pendiente</span>
                        )}
                      </div>

                     {
  laboratorios.find(
    (laboratorio) => laboratorio.slug === producto.laboratorio
  )?.nombre ?? "Fabricante por confirmar"
}
                      <h4>{producto.nombre}</h4>

                      <span class="detalle">
                        {producto.presentacion}
                      </span>

                      <span class="precio">
                        {formatoPrecio(producto.precioDetal)}
                      </span>
                    </a>
                  );
                })}
              </div>
            ) : (
              <p class="empty-category">
                Estamos preparando los productos de esta categoría.
              </p>
            )}
          </section>
        );
      })}
    </section>

    <!-- LABORATORIOS Y FABRICANTES -->
    <section
      id="laboratorios"
      class="catalogo-section"
      aria-labelledby="laboratorios-title"
    >
      <div class="section-heading">
        <p class="eyebrow">NUESTROS FABRICANTES</p>
        <h2 id="laboratorios-title">
          Diferentes orígenes. <span>Un catálogo.</span>
        </h2>
        <p>
          PÓCIMA reúne productos elaborados por diferentes
          fabricantes y laboratorios.
        </p>
      </div>

      <div class="laboratory-grid">
        {laboratorios.map((laboratorio) => (
          <article class="laboratory-card">
            <h3>{laboratorio.nombre}</h3>
          </article>
        ))}
      </div>
    </section>

    <!-- CONTACTO -->
    <section
      id="contacto"
      class="cta"
      aria-labelledby="contacto-title"
    >
      <p class="eyebrow">PÓCIMA</p>

      <h2 id="contacto-title">
        ¿Buscas un producto?
        <span>Estamos para ayudarte.</span>
      </h2>

      <p class="hero-text">
        Consulta las presentaciones disponibles y solicita información
        sobre tus productos de interés.
      </p>

      <a href="mailto:hola@pocima.co" class="button">
        Contactar
      </a>

      <p class="social">
        Síguenos en
        <a
          href={instagram}
          rel="me noopener"
          target="_blank"
          aria-label="PÓCIMA en Instagram (@pocimaco)"
        >@pocimaco</a>
      </p>
    </section>
  </main>

  <footer>
    <span>© {new Date().getFullYear()} PÓCIMA</span>
    <a href={instagram} rel="me noopener" target="_blank">
      @pocimaco
    </a>
    <a href="https://pocima.co/">pocima.co</a>
  </footer>

  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      });
    }

    let deferredPrompt;
    const installButton = document.querySelector("#install-pwa");

    window.addEventListener("beforeinstallprompt", (event) => {
      event.preventDefault();
      deferredPrompt = event;
      if (installButton) installButton.hidden = false;
    });

    installButton?.addEventListener("click", async () => {
      if (!deferredPrompt) return;

      deferredPrompt.prompt();
      await deferredPrompt.userChoice;

      deferredPrompt = null;
      installButton.hidden = true;
    });

    window.addEventListener("appinstalled", () => {
      if (installButton) installButton.hidden = true;
    });
  </script>
</body>

<style>
 @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap');
  :global(*) {
    
    box-sizing: border-box;
  }

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #0a0a0a;
  color: #f5f3ed;
  font-family: 'DM Sans', sans-serif;
}

  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 28px 6vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
  }

  .logo {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  nav {
    display: flex;
    gap: 32px;
    font-size: 14px;
    color: #aaa;
  }

  nav a {
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: white;
  }

  .hero {
    min-height: 100vh;
    padding: 120px 8vw 70px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 620px;
  }

  .eyebrow {
    margin-bottom: 22px;
    color: #aaa;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.25em;
  }

  h1,
  h2 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(64px, 8vw, 120px);
  }

  h2 {
    font-size: clamp(48px, 6vw, 86px);
  }

  h1 span,
  h2 span {
    display: block;
    color: #b8a47c;
  }

  .hero-text {
    max-width: 450px;
    margin: 32px 0;
    color: #aaa;
    font-size: 17px;
    line-height: 1.7;
  }

  .button {
    display: inline-flex;
    padding: 15px 24px;
    border: 1px solid #777;
    border-radius: 999px;
    font-size: 14px;
    transition: all 0.25s ease;
  }

  .button:hover {
    background: #f5f3ed;
    color: #0a0a0a;
    border-color: #f5f3ed;
  }

  .hero-product {
    position: relative;
    min-height: 650px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-product img {
    position: relative;
    z-index: 2;
    width: min(75%, 430px);
    max-height: 650px;
    object-fit: contain;
    filter: drop-shadow(0 35px 60px rgba(0, 0, 0, 0.8));
  }

  .glow {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: #b8a47c;
    opacity: 0.08;
    filter: blur(100px);
  }

  .product-section,
  .detail-section {
    padding: 140px 10vw;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10vw;
    align-items: center;
  }

  .section-image {
    display: flex;
    justify-content: center;
  }

  .section-image img {
    width: min(70%, 380px);
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.7));
  }

  .section-content p,
  .detail-section p {
    max-width: 520px;
    margin-top: 30px;
    color: #999;
    font-size: 17px;
    line-height: 1.8;
  }

  .specs {
    margin-top: 50px;
    display: flex;
    gap: 45px;
  }

  .specs div {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .specs strong {
    font-size: 22px;
  }

  .specs span {
    color: #777;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .cap-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 450px;
    background: #111;
    border: 1px solid #222;
  }

  .cap-card img {
    width: 70%;
  }

  .cta {
    min-height: 70vh;
    padding: 120px 8vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #10100f;
  }

  .cta h2 {
    margin-bottom: 45px;
  }

  footer {
    padding: 28px 6vw;
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 12px;
    border-top: 1px solid #1e1e1e;
  }

  @media (max-width: 800px) {
    nav {
      display: none;
    }

    .hero {
      grid-template-columns: 1fr;
      padding-top: 140px;
    }

    .hero-product {
      min-height: 480px;
    }

    .hero-product img {
      width: 70%;
    }

    .product-section,
    .detail-section {
      grid-template-columns: 1fr;
      padding: 100px 8vw;
    }

    .detail-section {
      display: flex;
      flex-direction: column;
    }

    .specs {
      gap: 25px;
      flex-wrap: wrap;
    }

    footer {
      flex-direction: column;
      gap: 10px;
    }
  }

  .install-button {
    border: 1px solid #b8a47c;
    background: transparent;
    color: #f5f3ed;
    padding: 10px 16px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .install-button:hover {
    background: #b8a47c;
    color: #0a0a0a;
  }

  @media (max-width: 800px) {
    .install-button {
      padding: 8px 12px;
      font-size: 11px;
    }
  }
/* Catálogo PÓCIMA: tema oscuro y dorado */

.catalogo-section {
  padding: 90px 8vw;
  scroll-margin-top: 90px;
}

.section-heading {
  max-width: 760px;
  margin: 0 auto 42px;
  text-align: center;
}

.section-heading > p:not(.eyebrow) {
  color: #999;
  line-height: 1.8;
}

.section-heading h2,
.group-heading h3,
.laboratory-card h3 {
  color: #f5f3ed;
}

.section-heading h2 span,
.hero-content h1 span,
.cta h2 span {
  display: block;
  color: #b8a47c;
}

.category-grid,
.laboratory-grid,
.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.category-card,
.laboratory-card,
.tarjeta-catalogo {
  min-width: 0;
  padding: 18px;
  border: 1px solid #292929;
  border-radius: 12px;
  background: #111;
  color: #f5f3ed;
}

.category-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-decoration: none;
  transition: border-color 0.2s ease;
}

.category-card:hover,
.tarjeta-catalogo:hover {
  border-color: #b8a47c;
}

.category-name {
  font-size: 17px;
  font-weight: 600;
}

.category-description,
.group-heading p,
.empty-category {
  color: #999;
  font-size: 14px;
  line-height: 1.7;
}

.category-link,
.fabricante {
  color: #b8a47c;
  font-size: 12px;
}

.catalog-category {
  margin-top: 54px;
  scroll-margin-top: 90px;
}

.group-heading {
  margin-bottom: 20px;
}

.group-heading h3 {
  margin-bottom: 8px;
  font-size: 22px;
}

.tarjeta-catalogo {
  display: flex;
  flex-direction: column;
  gap: 10px;
  text-decoration: none;
}

.foto-catalogo {
  display: grid;
  min-height: 210px;
  place-items: center;
  overflow: hidden;
  border-radius: 8px;
  background: #191919;
  color: #999;
  font-size: 12px;
}

.foto-catalogo img {
  width: 100%;
  height: 210px;
  object-fit: contain;
}

.tarjeta-catalogo h4 {
  margin: 0;
  color: #f5f3ed;
  font-size: 16px;
  line-height: 1.4;
}

.tarjeta-catalogo .detalle {
  color: #999;
  font-size: 13px;
}

.tarjeta-catalogo .precio {
  margin-top: auto;
  padding-top: 6px;
  color: #b8a47c;
  font-size: 18px;
  font-weight: 600;
}

.laboratory-card h3 {
  margin: 0;
  font-size: 16px;
}

.brand-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.brand-mark {
  position: relative;
  z-index: 1;
  color: #f5f3ed;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(38px, 6vw, 72px);
  letter-spacing: 0.12em;
}

.brand-mark span {
  display: block;
  margin-top: 18px;
  color: #b8a47c;
  font-family: "DM Sans", sans-serif;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

@media (max-width: 800px) {
  .catalogo-section {
    padding: 70px 6vw;
  }

  .category-grid,
  .laboratory-grid,
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .category-grid,
  .laboratory-grid,
  .product-grid {
    grid-template-columns: 1fr;
  }
}
</style>
