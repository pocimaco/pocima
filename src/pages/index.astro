---
const title = 'Pócima';
const description =
  'Pócima — bebida a base de agua con fruta, disponible en formatos de 330 ml y 30 ml / 1 fl oz.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />

    <link rel="canonical" href="https://pocima.co/" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/pocima-192.png" />
    <link rel="apple-touch-icon" href="/icons/pocima-192.png" />

    <meta property="og:title" content="Pócima" />
    <meta
      property="og:description"
      content="Pócima — bebida a base de agua con fruta, disponible en formatos de 330 ml y 30 ml / 1 fl oz."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pocima.co/" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Pócima" />
    <meta
      name="twitter:description"
      content="Pócima — bebida a base de agua con fruta."
    />
  </head>

  <body>
    <header class="navbar">
      <button id="install-pwa" class="install-button" hidden>
        Instalar Pócima
      </button>

      <a href="/" class="logo">PÓCIMA</a>

      <nav>
        <a href="#producto">Producto</a>
        <a href="#detalle">Detalles</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">PÓCIMA · ORIGEN PLUS</p>

          <h1>
            PÓCIMA
            <span>ORIGEN PLUS.</span>
          </h1>

          <p class="hero-text">
            Bebida a base de agua con fruta, presentada en dos formatos:
            330 ml para tener en casa y 30 ml / 1 fl oz para llevar.
          </p>

          <a href="#producto" class="button">
            Conocer Pócima
          </a>
        </div>

        <div class="hero-product">
          <div class="glow"></div>

          <img
            src="/images/envase-pocima-25ml.webp"
            alt="Pócima"
          />
        </div>
      </section>

      <!-- PRODUCTO -->
      <section id="producto" class="product-section">
        <div class="section-image">
          <img
            src="/images/envase-pocima-25ml.webp"
            alt="Pócima"
          />
        </div>

        <div class="section-content">
          <p class="eyebrow">Pócima</p>

          <h2>
            Una fórmula.
            <span>Dos formatos.</span>
          </h2>

          <p>
            Pócima es una bebida a base de agua con fruta.
            Su propuesta contempla una presentación de 330 ml para tener en
            casa y una presentación individual de 30 ml / 1 fl oz para llevar.
          </p>

          <div class="specs">
            <div>
              <strong>330 ml</strong>
              <span>Formato hogar</span>
            </div>

            <div>
              <strong>30 ml</strong>
              <span>Formato individual</span>
            </div>

            <div>
              <strong>1 fl oz</strong>
              <span>Presentación individual</span>
            </div>
          </div>
        </div>
      </section>

      <!-- DETALLE -->
      <section id="detalle" class="detail-section">
        <div>
          <p class="eyebrow">LA PROPUESTA</p>

          <h2>
            Pócima
            <span>se adapta.</span>
          </h2>

          <p>
            El formato de 330 ml está pensado para tener Pócima disponible
            en casa. El formato individual de 30 ml / 1 fl oz está pensado
            para llevar fácilmente contigo.
          </p>

          <p>
            La presentación, el contenido y la información del producto se
            irán actualizando conforme avance la producción y tengamos la
            información técnica definitiva.
          </p>
        </div>

        <div class="cap-card">
          <img
            src="/images/tapa-blanca.webp"
            alt="Detalle del envase de Pócima"
          />
        </div>
      </section>

      <!-- CONTACTO -->
      <section id="contacto" class="cta">
        <p class="eyebrow">Pócima</p>

        <h2>
          Una fórmula.
          <span>Dos formas de llevarla.</span>
        </h2>

        <a href="mailto:hola@pocima.co" class="button">
          Contactar
        </a>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Pócima</span>
      <span>pocima.co</span>
    </footer>

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>

    <script>
      let deferredPrompt;

      const installButton = document.querySelector('#install-pwa');

      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();

        deferredPrompt = event;

        if (installButton) {
          installButton.hidden = false;
        }
      });

      installButton?.addEventListener('click', async () => {
        if (!deferredPrompt) return;

        deferredPrompt.prompt();

        await deferredPrompt.userChoice;

        deferredPrompt = null;
        installButton.hidden = true;
      });

      window.addEventListener('appinstalled', () => {
        if (installButton) {
          installButton.hidden = true;
        }
      });
    </script>
  </body>
</html>
